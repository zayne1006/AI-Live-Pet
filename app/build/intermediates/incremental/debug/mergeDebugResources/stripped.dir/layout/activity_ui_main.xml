<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:title="设置"
            android:titleTextColor="#333333"
            android:background="@android:color/transparent"
            app:navigationIcon="@android:drawable/ic_menu_revert" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="皮肤与显示"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#4A6FA5"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_skin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="皮肤管理（切换 / 导入 / 删除）"
            android:backgroundTint="#4A6FA5"
            android:textColor="#FFFFFF" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="调整悬浮窗尺寸"
            android:backgroundTint="#6A8FB5"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="行为设置"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#4A6FA5"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_switch_toggles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="行为开关（自言自语 / 通知碎碎念）"
            android:backgroundTint="#8FA9C5"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="后端配置"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#4A6FA5"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_supabase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Supabase 配置（可选）"
            android:backgroundTint="#A8BFD4"
            android:textColor="#333333" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="关于"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#4A6FA5"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="关于 AI 桌宠"
            android:backgroundTint="#C5D5E5"
            android:textColor="#333333" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>